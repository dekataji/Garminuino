<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollSetup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_below="@+id/tab_layout"
    android:saveEnabled="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dip"
            android:background="@color/horizontal_line" />

        <TextView
            android:id="@+id/textView8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_title_arrow_type"
            android:textSize="@dimen/option_title_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchArrowType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="false"
            android:paddingTop="@dimen/option_padding_top"
            android:paddingBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_element_arrow_type_v1"
            android:textSize="@dimen/option_text_size" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dip"
            android:background="@color/horizontal_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_title_session"
            android:textSize="@dimen/option_title_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchAutoStartNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:paddingTop="@dimen/option_padding_top"
            android:paddingBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_element_auto_start_navigation"
            android:textSize="@dimen/option_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_title_navigation_diagnostics"
            android:textSize="@dimen/option_title_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNavigationDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:paddingTop="@dimen/option_padding_top"
            android:paddingBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_element_navigation_diagnostics"
            android:textSize="@dimen/option_text_size" />

        <TextView
            android:id="@+id/textNavigationDiagnosticsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_navigation_diagnostics_inactive"
            android:textSize="@dimen/option_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_navigation_diagnostics_description"
            android:textSize="@dimen/option_text_size" />

        <Button
            android:id="@+id/buttonExportDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/layout_button_export_diagnostics" />

        <Button
            android:id="@+id/buttonClearDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/option_padding_bottom"
            android:text="@string/layout_button_clear_diagnostics" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="2dip"
            android:background="@color/horizontal_line" />


        <TextView
            android:id="@+id/textView7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_title_design"
            android:textSize="@dimen/option_title_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDarkModeAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="false"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_element_darkmode_auto"
            android:textSize="@dimen/option_text_size" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDarkModeMan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:checked="false"
            android:paddingTop="@dimen/option_padding_top"
            android:text="@string/layout_element_darkmode_man"
            android:textSize="@dimen/option_text_size" />

    </LinearLayout>
</ScrollView>
