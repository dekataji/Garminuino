<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <!-- Base color replaced at runtime via setBackgroundTintList().
         Dark default so untinted state doesn't flash white on OLED. -->
    <solid android:color="@color/oled_surface_variant" />
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="6dp"
        android:bottom="6dp" />
</shape>
